# AIGRA Ops Platform Environment Configuration Template

# Database Connection (Leave blank or set to postgresql://... on Render)
DATABASE_URL=sqlite:///./aigraops.db

# GitHub Personal Access Token (Requires 'repo' scope for automated PR creation)
# Generate from: https://github.com/settings/tokens
GITHUB_TOKEN=

# Groq Cloud Free API Key (Provides LLaMA-3 AI repair and SRE assistant inference)
# Obtain free key at: https://console.groq.com/keys
GROQ_API_KEY=

# Security & Authentication
SECRET_KEY=supersecretkey
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Environment Mode
ENVIRONMENT=production
